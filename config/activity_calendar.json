      "confidence": "planning_default",
      "note": "Execution party unconfirmed. Testing executed by a third-party agency or consultant is assumed to run on business days; on-site contractor T&C may run on the site calendar. Override once the execution party is confirmed."
    },
    "DESIGN": {
