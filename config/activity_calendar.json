{
  "version": "1.1.0",
  "principle": "PROJECT CALENDAR != ACTIVITY CALENDAR != RESOURCE CALENDAR. A 7D site operating calendar must never propagate to design / tender / client approval / authority review / individual resource calendars.",
  "scope_note": "These are default PLANNING PROFILES for mainland-China commercial fit-out, not legal facts. Every assignment carries basis + confidence and supports project override.",
  "calendar_definitions": {
    "SITE_7D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 7,
      "holiday_policy": "spring_festival_only",
      "description": "Site construction / installation: weekends working, only Spring Festival (incl. Lantern return) off."
    },
    "SITE_6D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 6,
      "holiday_policy": "spring_festival_only",
      "description": "Site construction on a 6-day week: Sunday off, statutory holidays working except Spring Festival."
    },
    "SITE_5D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 5,
      "holiday_policy": "all_statutory_holidays_off",
      "description": "Site construction falling back to the business week (weekends off, all statutory holidays off)."
    },
    "BUSINESS_5D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 5,
      "holiday_policy": "all_statutory_holidays_off",
      "description": "Design / consultant / client / tender / authority business calendar."
    },
    "AUTHORITY_5D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 5,
      "holiday_policy": "all_statutory_holidays_off_plus_statutory_windows",
      "description": "Authority processing runs on government business days; statutory review windows are counted in those days."
    },
    "FACTORY_6D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 6,
      "holiday_policy": "factory_calendar_unconfirmed",
      "description": "Factory production / fabrication: 6-day week assumed provisionally; factory-specific calendar not evidenced."
    },
    "LOGISTICS_7D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 7,
      "holiday_policy": "carrier_calendar_unconfirmed",
      "description": "Logistics / delivery: 7-day assumed; carrier and customs calendar not evidenced."
    },
    "ELAPSED_7D": {
      "calendar_type": "ACTIVITY",
      "working_days_per_week": 7,
      "holiday_policy": "none",
      "description": "Continuous calendar-day window, independently declared; not site work."
    }
  },
  "class_defaults": {
    "SITE_CONSTRUCTION": {
      "calendar_id": "SITE_7D",
      "site_calendar_bound": true,
      "basis": "default_cn_commercial_fitout_site_calendar",
      "confidence": "planning_default"
    },
    "SITE_INSTALLATION": {
