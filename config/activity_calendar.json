  "resource_calendar": {
    "implemented": false,
    "statement": "ACTIVITY CALENDAR is not the INDIVIDUAL RESOURCE CALENDAR. A 7D site operating calendar means the SITE may be worked 7 days per week; it does NOT mean one crew works 7 consecutive days.",
    "not_implemented_reason": "Crew availability / rotation / shift / per-resource calendars are not modelled this round. No fatigue model is claimed. The engine only guarantees the two concepts are reported separately and never conflated.",
    "disclosure": "7D site calendar != 7 consecutive worker-days per individual worker. Crew rotation, shifts and resource calendars require separate modelling."
