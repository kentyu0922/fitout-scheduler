  "link_policy": [
    {
      "id": "ONTO-01",
      "predecessor": "demolition",
      "successor": "waste_removal",
      "condition": "workface.demolished",
      "single_workfront_relationship": "FS",
      "sectional_relationship": "FF",
      "lag": 0,
      "max_lag": 10,
      "rationale": "渣料随拆除逐段形成，清运与拆除同步收尾；FF 保证清运不早于拆除完成，同时附加 SS 锚点防止清运在拆除开始前就被排到前面。",
      "confidence": "medium"
    },
    {
      "id": "ONTO-02",
      "predecessor": "demolition",
      "successor": "setting_out",
      "condition": "workface.demolished",
      "single_workfront_relationship": "FS",
      "sectional_relationship": "FS",
      "lag": 0,
      "max_lag": 10,
      "rationale": "放线必须在原装修拆除后量测；渣料清运以 FF 与拆除收口，可与放线并行，故放线对拆除保持 FS。",
      "confidence": "medium"
    },
    {
      "id": "ONTO-03",
      "predecessor": "setting_out",
      "successor": "partition_framing",
      "condition": "workface.set_out",
      "single_workfront_relationship": "FS",
      "sectional_relationship": "SS",
      "lag": 0,
      "max_lag": 10,
      "rationale": "放线基准按分区交付；分区流水下隔墙可在首个分区基准完成后跟进，无需等全层放线结束。",
      "confidence": "high"
    },
    {
      "id": "ONTO-04",
      "predecessor": "partition_framing",
      "successor": "gypsum_boarding",
      "condition": "partition.frame_ready",
      "single_workfront_relationship": "FS",
      "sectional_relationship": "FS",
