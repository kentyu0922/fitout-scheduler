{
  "version": "6.0.0",
  "description": "V6.0 dependency ontology — typed, condition-based construction logic. Single source of truth for why a link is FS / SS / FF / SF and with what lag. The legacy keyword table (config/dependency_rules.json#rules) and the flat typed table (#fitout_rules) are kept for compatibility only; a regression test asserts this ontology covers them.",
  "provenance": {
    "derived_from": [
      "config/dependency_rules.json#fitout_rules (14 typed trade releases, v0.1.0)",
      "config/fitout_wbs.json#predecessors (coarse package network)",
      "config/fitout_wbs.json#inspection_requirements (concealed-work release gates)"
    ],
    "status": "provisional",
    "not_a_source_of": [
      "productivity rates",
      "durations",
      "crew sizes"
    ],
    "note": "This file models construction logic only. It never sets duration, and it must never be used to justify removing an inspection, approval or statutory gate."
  },
  "condition_classes": {
    "hard": {
      "label_zh": "硬依赖",
      "label_en": "Hard (physical)",
      "definition": "前道工序形成的实体状态未到位，后道工序在物理上无法施工。",
      "example": "机电一次安装未完成 → 天花不得封闭。",
      "overridable": true,
      "may_overlap_when": "条件作用域为 zone 且分区流水已启用时，可在分区层面重叠。"
    },
    "information": {
      "label_zh": "信息依赖",
      "label_en": "Information",
      "definition": "实体上可施工，但缺少已批准的信息（图纸 / 技术参数 / 封样）而不能开工。",
      "example": "设计冻结 → 长周期采购发布。",
      "overridable": true,
      "may_overlap_when": "信息可按分部提前分批冻结。"
    },
    "resource": {
      "label_zh": "资源依赖",
      "label_en": "Resource contention",
      "definition": "不构成先后逻辑，仅表示两道工序争夺同一工作面、通道或工种。不产生网络边，只产生资源竞争组，供 V6.2 资源优化消费。",
      "example": "隔墙封板与墙面批腻子共用同一作业面。",
      "emits_edge": false
    },
    "inspection": {
      "label_zh": "检查依赖",
      "label_en": "Inspection / hold point",
      "definition": "法定或合同约定的隐蔽工程验收、检测、盲测。通过后覆盖工序方可继续。",
      "example": "天花隐蔽工程验收 → 天花封板。",
      "overridable": false,
      "may_overlap_when": null
    },
    "authority": {
      "label_zh": "权威依赖",
      "label_en": "Statutory / authority",
      "definition": "政府许可、图审合格证、质安监报监等行政行为。未取得即开工属违规。",
      "example": "施工许可证取得 → 现场施工开始。",
      "overridable": false,
      "may_overlap_when": null
    }
  },
  "relationship_policy": {
    "hard": {
      "single_workfront": "FS",
      "sectional": "SS",
      "lag_basis": "workfront_pipeline",
      "lag_rule": "clamp(ceil(predecessor_duration_days / workfronts), lag_min, lag_max)"
    },
    "information": {
      "single_workfront": "FS",
      "sectional": "FS",
      "lag_basis": "none"
    },
    "inspection": {
      "single_workfront": "FS",
      "sectional": "FS",
      "lag_basis": "none",
      "note": "Hold points are never overlapped. Scope is floor/project in the current model; when gates become zone-scoped in V6.1 this policy must be revisited explicitly, not silently relaxed."
    },
    "authority": {
      "single_workfront": "FS",
      "sectional": "FS",
      "lag_basis": "none",
      "note": "Statutory gates are never overlapped and never dropped."
    },
    "resource": {
      "emits_edge": false
    }
  },
  "scope_policy": {
    "zone": "按分区形成。分区流水启用时允许 SS 重叠。",
    "floor": "整层形成后才可用。任何情况下不允许 SS 重叠。",
    "project": "全项目形成后才可用。任何情况下不允许 SS 重叠。",
    "note": "SS 的充分条件：条件类别允许重叠 AND 条件作用域为 zone AND 决策为分区流水(workfronts>1)。三者缺一则回落到 FS。"
  },
  "gate_policy": {
    "force_fs_when_gated": true,
    "force_fs_label": "inspection_gate_ids / inspection_required",
    "force_fs_reason": "后继工序的完成被检查门约束时（inspection_gate_ids / inspection_required），其全部入边强制 FS：否则 SS 会让工作面在被验收之前就推进到下一分区。",
    "v61_relaxation": "当检查门在 V6.1 变为分区作用域（每个 zone 各自报验）后，此规则可显式放宽为 SS；放宽必须改配置并跑回归，不得由调用方临时传参绕过。",
    "inspection_owned_by": "gate_task",
    "note": "inspection 类条件的边由 WBS 展开期的 inspection_gate_ids 机制落定，本体只做校验、不重复落边，避免双重所有权。"
  },
