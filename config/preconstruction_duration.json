  "statutory": {
    "sprinkler_strength_test_days": {
      "days": 1,
      "unit": "working_days",
      "lock": true,
      "basis": "GB 50261-2017第6.2.1条：工作压≤1.0MPa时试验压=1.5倍且≥1.4MPa，稳压30min压降≤0.05MPa；时钟工序，不随面积延长。"
    },
    "hydrostatic_test_days": {
      "days": 1,
      "unit": "calendar_days",
      "lock": true,
      "basis": "GB 50261-2017第6.2.2条：严密性试验为工作压稳压24h无渗漏；日历时钟，不随面积延长。"
    },
    "formal_tender_prepare_days": {
      "days": 20,
      "unit": "calendar_days",
      "lock": true,
      "basis": "《招标投标法》第24条（2017-12-27修正）：依法必须招标的项目，自招标文件开始发出之日起至提交投标文件截止之日止，最短不得少于20日。仅 statutory_tender_required=true 时锁定；不随面积延长。"
    },
    "publicity_days": {
      "days": 3,
      "unit": "calendar_days",
      "lock": true,
      "basis": "《招标投标法实施条例》第54条（2019修订）：依法必须招标项目的中标候选人公示期不得少于3日。仅必须招标时锁定。"
    },
    "duct_leakage_check_days": {
      "days": 1,
      "unit": "working_days",
      "lock": true,
      "basis": "GB 50243-2016第4.2.1条及附录C.1：风管严密性检测（低压1.5倍、中压1.2倍且≥750Pa保持≥5min）；时钟检测，不随面积延长。"
    },
    "electrical_conduit_check_days": {
      "days": 1,
      "unit": "working_days",
      "lock": true,
      "basis": "GB 50303-2015第3.3.11条：电气导管隐蔽前应检查合格；吊顶内配管先放样并与各专业商定。时钟检查，不随面积延长。"
    },
    "shanghai_drawing_review_workdays": {
      "days": 5,
      "unit": "working_days",
      "lock": true,
      "basis": "沪建规范〔2025〕12号：既有建筑装修须审图者审图5个工作日（2025-09-15公布、2025-12-01施行）。法定时限不随面积延长。"
    },
    "shanghai_permit_issue_workdays": {
      "days": 2,
      "unit": "working_days",
      "lock": true,
      "basis": "沪建规范〔2025〕12号：既有建筑装修施工许可发证2个工作日。法定时限不随面积延长。"
    },
    "fire_design_review_special_workdays": {
      "days": 15,
      "unit": "working_days",
      "lock": true,
      "basis": "《建设工程消防设计审查验收管理暂行规定》第58号令第23条：特殊建设工程消防设计审查自受理之日起15个工作日；仅 fire_classification=special 时进入许可链，不随面积延长。"
    }
  },
