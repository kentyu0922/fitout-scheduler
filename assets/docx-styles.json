{
  "_comment": "Document styles for docx. Source Sans Pro maps to Arial in .docx for Word/Office compatibility (Source Sans is not Office-default). Source Serif Pro Italic maps to Times New Roman Italic. Sentence case is enforced.",
  "version": "0.1.0",
  "fonts": {
    "primary": "Arial",
    "primary_fallback": "Source Sans Pro",
    "serif_italic": "Times New Roman",
    "monospace": "Consolas"
  },
  "weights": {
    "light": 300,
    "regular": 400,
    "semibold": 600,
    "bold": 700
  },
  "colors": {
    "accent_red": "E30613",
    "space": "003E51",
    "midnight": "131E29",
    "ocean": "BCDEE6",
    "sand": "E0C6AD",
    "ink": "1A1A1A",
    "rule_grey": "C9C9C9",
    "placeholder_grey": "888888"
  },
  "text_styles": {
    "cover_title": {
      "font": "Arial",
      "size": 56,
      "weight": "light",
      "color": "003E51"
    },
    "cover_subtitle": {
      "font": "Arial",
      "size": 28,
      "weight": "regular",
      "color": "003E51"
    },
    "cover_byline": {
      "font": "Arial",
      "size": 14,
      "weight": "semibold",
      "color": "1A1A1A"
    },
    "h1": {
      "font": "Arial",
      "size": 36,
      "weight": "light",
      "color": "003E51"
    },
    "h2": {
      "font": "Arial",
      "size": 22,
      "weight": "light",
      "color": "003E51"
    },
    "h3": {
      "font": "Arial",
      "size": 16,
      "weight": "semibold",
      "color": "003E51"
    },
    "body": {
      "font": "Arial",
      "size": 11,
      "weight": "regular",
      "color": "1A1A1A"
    },
    "pull_quote": {
      "font": "Times New Roman",
      "italic": true,
      "size": 18,
      "weight": "regular",
      "color": "003E51"
    },
    "caption": {
      "font": "Arial",
      "size": 9,
      "weight": "regular",
      "color": "555555"
    },
    "footer": {
      "font": "Arial",
      "size": 9,
      "weight": "regular",
      "color": "888888"
    },
    "label": {
      "font": "Arial",
      "size": 10,
      "weight": "semibold",
      "color": "003E51"
    },
    "placeholder": {
      "font": "Consolas",
      "size": 11,
      "weight": "regular",
      "color": "888888"
    }
  },
  "page": {
    "size": "letter",
    "margin_inches": {
      "top": 1.0,
      "bottom": 1.0,
      "left": 1.0,
      "right": 1.0
    }
  },
  "rules": {
    "sentence_case_only": true,
    "smart_quotes_only": true,
    "no_emoji": true,
    "hyperlink_emails_and_urls": true,
    "accent_red_use": "accent_only",
    "lockup_use": "image_lockup_only_never_typed"
  }
}
